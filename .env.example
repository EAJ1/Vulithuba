# Copy this file to .env and replace the values.
# For Gmail, enable 2-Step Verification and use a new 16-character App Password,
# not your normal Gmail password. Enter it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_TO=your-email@gmail.com

# Twilio SMS notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1234567890
SMS_TO=+27123456789
TWILIO_VERIFY_SERVICE_SID=

# PayFast payments
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

# Infobip SMS verification (API key scope: sms:message:send)
# Set SMS_PROVIDER=infobip after entering your account settings.
# SMS_PROVIDER=infobip
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=

# BulkSMS API tokens (not your account password)
# SMS_PROVIDER=bulksms
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
