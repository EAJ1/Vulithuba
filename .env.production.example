# Public hostname only, without https:// or a trailing slash.
DOMAIN=your-domain.example
# Used only when creating an admin in an empty database.
# Existing admin passwords are never changed at startup.
ADMIN_INITIAL_PASSWORD=
# Add your SMTP, Twilio and payment settings here if needed.

# Customer SMS verification (keep credentials server-side).
SMS_PROVIDER=clicksend
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Admin verification uses email, never requires a phone number.
ADMIN_VERIFICATION_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_TO=
